# ratelimitd environment (docs/PLAN.md env table). Copy to .env for local runs.
GRPC_ADDR=:50053
HTTP_ADDR=:8093
ADMIN_ADDR=127.0.0.1:9130

REDIS_ADDR=127.0.0.1:6380
REDIS_POOL_SIZE=64
REDIS_CLUSTER=false
REDIS_TIMEOUT=50ms

POLICY_FILE=policies.yaml
POLICY_POLL=2s

FALLBACK_MODE=local
FALLBACK_DIVISOR=1
BREAKER_RATIO=0.5
BREAKER_MIN=20
BREAKER_OPEN_FOR=5s
BREAKER_PROBE=500ms

LOCAL_SHARDS=256
LOCAL_IDLE_TTL=10m
LOCAL_MAX_KEYS=1000000

MAX_CLOCK_SKEW=2s
TRUST_CLIENT_CLOCK=false

SHUTDOWN_TIMEOUT=10s
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info
LOG_FORMAT=text
